# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

# Force LF for all YAML, Markdown, Python, shell scripts
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.txt  text eol=lf
*.tpl  text eol=lf
*.json text eol=lf
*.sh   text eol=lf

# Dockerfile
Dockerfile text eol=lf
.dockerignore text eol=lf

# Keep binary files as-is
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.tgz  binary
